# ==============================================================================
# .env.example
# ------------------------------------------------------------------------------
# Copy this file to ".env" (which is gitignored) and fill in real values.
# Never commit a real ".env" file -- it holds your API key.
# ==============================================================================

# LLM provider: "gemini" (needs GEMINI_API_KEY below) or "databricks" (fully
# keyless when this app runs inside a Databricks notebook, job, or App).
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model used to generate answers. Gemini model names change fairly
# often -- if this one 404s with a "no longer available" message, call
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY to
# see current models and pick a "*-flash" one (fast + cheap, good for RAG).
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.1
# Give up on a single Gemini chat request after this many seconds (a stalled
# connection would otherwise hang the chat turn forever).
GEMINI_REQUEST_TIMEOUT_SECONDS=60

# Databricks (only used when LLM_PROVIDER=databricks and/or
# EMBEDDING_PROVIDER=databricks). Leave HOST/TOKEN blank when this app runs
# INSIDE Databricks (notebook/job/App) -- auth is then fully automatic and
# no key exists anywhere in this app's config. Fill them in only to test
# against a real workspace from an external machine.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
DATABRICKS_TEMPERATURE=0.1

# Embedding provider: "gemini" (hosted, uses GEMINI_API_KEY) or "databricks"
# (fully keyless inside a Databricks workspace). No model is downloaded
# either way. After changing it, delete vectorstore_db/ and re-run
# `python -m scripts.ingest` -- vectors from different models don't mix.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_BATCH_SIZE=32

# Vector store (ChromaDB, local on-disk)
CHROMA_PERSIST_DIR=vectorstore_db
CHROMA_COLLECTION_NAME=insurance_docs
METADATA_DB_PATH=vectorstore_db/metadata.sqlite

# Ingestion
PDF_DATA_DIR=data/pdfs

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
# Minimum relevance score (0-1, raw vector similarity) a chunk must clear to
# be used/shown as a source. Model-specific: 0.81 was measured for
# gemini-embedding-001 on these documents (see config/settings.py).
# 0.0 disables filtering, so TOP_K sources are always shown.
SCORE_THRESHOLD=0.81
ENABLE_HYBRID_SEARCH=true

# Multi-query retrieval: search with several LLM-generated paraphrasings of
# the question, not just its literal wording, then fuse the results. Off by
# default -- it costs one extra Gemini CHAT call per question, and the free
# tier's chat quota is only 5 requests/minute (shared with query rewriting
# and answer generation below).
ENABLE_MULTI_QUERY=false
MULTI_QUERY_VARIANTS=3

# Multi-hop retrieval: after the first retrieval, let the model ask itself a
# follow-up search query if the question needs a second, different piece of
# information the first pass didn't surface. Off by default for the same
# free-tier chat quota reason as above. MAX_HOPS caps how many extra rounds
# (2 = one initial retrieval + at most one follow-up).
ENABLE_MULTI_HOP=false
MAX_HOPS=2

# Conversation memory
MAX_HISTORY_TURNS=6

# Observability
MLFLOW_TRACKING_DIR=mlruns
MLFLOW_EXPERIMENT_NAME=insurance-rag-chatbot
FEEDBACK_LOG_PATH=vectorstore_db/feedback.jsonl

LOG_LEVEL=INFO
